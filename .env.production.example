# Configuración de ejemplo para producción
# Copiar este archivo a .env y ajustar los valores según sea necesario

# ============================================
# CONFIGURACIÓN DEL PROXY
# ============================================
# Prefijo de URL para el proxy reverso
# En desarrollo local: dejar vacío o comentar
# En producción: /proxy.php
FORCE_SCRIPT_NAME=/proxy.php

# ============================================
# CONFIGURACIÓN GENERAL DE DJANGO
# ============================================
DEBUG=False
SECRET_KEY=tu-secret-key-super-segura-aqui

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=indicadores.cali.gov.co,www.indicadores.cali.gov.co

# ============================================
# BASE DE DATOS
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=indicadores
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# ARCHIVOS ESTÁTICOS Y MEDIA
# ============================================
# Estas URLs se construyen automáticamente con FORCE_SCRIPT_NAME
# No es necesario configurarlas manualmente

# ============================================
# SEGURIDAD
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# CORS (si es necesario)
# ============================================
# CORS_ALLOWED_ORIGINS=https://indicadores.cali.gov.co

# ============================================
# CACHE (Redis)
# ============================================
# REDIS_URL=redis://127.0.0.1:6379/1

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# CSRF
# ============================================
CSRF_TRUSTED_ORIGINS=https://indicadores.cali.gov.co,http://indicadores.cali.gov.co

# ============================================
# BREVO / EMAIL
# ============================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sistemaestadistico@cali.gov.co
BREVO_NOTIFY_EMAILS=
SITE_URL=https://indicadores.cali.gov.co
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=sistemaestadistico@cali.gov.co
SERVER_EMAIL=sistemaestadistico@cali.gov.co

# ============================================
# APACHE SUPERSET
# ============================================
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_PUBLIC_URL=https://indicadores.cali.gov.co/superset
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_DATABASE_NAME=SIIED - Indicadores
SUPERSET_SHARED_PASSWORD=

# ============================================
# LLM (Chat Don Datico)
# ============================================
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CEREBRAS_MODEL=gemini-3.5-flash-lite
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://api.cerebras.ai/v1
OLLAMA_MODEL=gpt-oss-120b
