# ============================================================================
# VARIABLES DE ENTORNO — SIIED
# Copiar a .env y completar con los valores del entorno.
# ============================================================================

# --- Django ---
DEBUG=True
SECRET_KEY=django-insecure-generar-una-nueva-clave-segura
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# Prefijo de URL para proxy reverso (producción: /proxy.php). Local: vacío.
FORCE_SCRIPT_NAME=

# --- Base de datos (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=indicadores
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Brevo / Email transaccional ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_NOTIFY_EMAILS=
SITE_URL=https://indicadores.cali.gov.co
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# --- Apache Superset (módulo Tableros) ---
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_PUBLIC_URL=http://127.0.0.1:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_DATABASE_NAME="SIIED - Indicadores"
SUPERSET_SHARED_PASSWORD=

# --- LLM (Chat Don Datico) ---
# API Principal (Google AI Studio vía endpoint OpenAI-compatible)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CEREBRAS_MODEL=gemini-3.5-flash-lite
# API de respaldo (los nombres OLLAMA_* son históricos; puede apuntar a Cerebras)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://api.cerebras.ai/v1
OLLAMA_MODEL=gpt-oss-120b
